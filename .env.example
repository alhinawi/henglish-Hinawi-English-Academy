# ==============================================================================
# Henglish Academy (HENGLISH) - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local or .env for production deployment.
# ==============================================================================

# Application Environment ('development' | 'production')
VITE_APP_ENV=development
VITE_PORT=5173

# ------------------------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Replace with your Supabase Project URL and Public Anon Key.
# If left blank or unconfigured, Henglish automatically activates the
# persistent offline local session engine with zero interruption.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ------------------------------------------------------------------------------
# AI TUTOR AGENT CONFIGURATION
# ------------------------------------------------------------------------------
# Configurable AI Provider: 'gemini' | 'openai' | 'anthropic'
VITE_AI_PROVIDER=gemini
# Your AI API key. If omitted, the platform uses its built-in educational
# knowledge brain without faking or throwing errors.
VITE_AI_API_KEY=your_ai_api_key_here

# ------------------------------------------------------------------------------
# YOUTUBE DATA API (Optional - Official Embeds work without API Key)
# ------------------------------------------------------------------------------
VITE_YOUTUBE_API_KEY=your_youtube_api_key_optional
