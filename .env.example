# ==============================================================================
# Henglish Academy (HENGLISH) - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local or .env for local development & deployment.
# ==============================================================================

# Application Environment ('development' | 'production')
VITE_APP_ENV=development
VITE_PORT=5173

# ------------------------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Replace with your Supabase Project URL and Public Anon Key.
# If unconfigured, Henglish activates its robust local persistent session engine.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ------------------------------------------------------------------------------
# SECURE SERVER-SIDE AI PROVIDER CONFIGURATION
# Keys placed here are read ONLY by the server layer and NEVER leaked to the client.
# ------------------------------------------------------------------------------
# AI Provider: 'gemini' | 'openai' | 'local'
AI_PROVIDER=gemini

# AI Model Identifier:
# For Gemini: 'gemini-2.5-flash' | 'gemini-1.5-flash' | 'gemini-1.5-pro'
# For OpenAI: 'gpt-4o-mini' | 'gpt-4o'
AI_MODEL=gemini-2.5-flash

# Google Gemini API Key:
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (if AI_PROVIDER=openai):
OPENAI_API_KEY=your_openai_api_key_here

# Request timeout in milliseconds (default: 30000)
REQUEST_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# NATURAL AI VOICE & TTS ENGINE CONFIGURATION
# ------------------------------------------------------------------------------
# TTS Provider: 'browser' (default high-fidelity fallback) | 'elevenlabs' | 'google-cloud' | 'kokoro'
TTS_PROVIDER=browser

# ElevenLabs API Key (Optional premium natural voice provider)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google Cloud Text-to-Speech API Key (Optional)
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# Kokoro TTS Self-Hosted Endpoint (Optional, e.g. http://localhost:8880/v1/audio/speech)
KOKORO_TTS_ENDPOINT=

# ------------------------------------------------------------------------------
# YOUTUBE DATA API (Optional - Official Embeds work without API Key)
# ------------------------------------------------------------------------------
VITE_YOUTUBE_API_KEY=your_youtube_api_key_optional
