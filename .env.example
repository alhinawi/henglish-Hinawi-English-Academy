# ==============================================================================
# Henglish Academy (HENGLISH) - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local or .env for local development & deployment.
# ==============================================================================

# Application Environment ('development' | 'production')
VITE_APP_ENV=development
VITE_PORT=5173

# ------------------------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Replace with your Supabase Project URL and Public Anon Key.
# If unconfigured, Henglish activates its robust local persistent session engine.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ------------------------------------------------------------------------------
# CENTRALIZED MULTI-PROVIDER AI CONFIGURATION (SERVER-SIDE ONLY)
# Routing Priority: Groq -> Google Gemini -> Cloudflare Workers AI -> OpenAI
# Keys placed here are read ONLY by the server layer and NEVER leaked to the client.
# ------------------------------------------------------------------------------
# 1. Groq (Primary Provider - Ultra-fast LPU Llama 3.3 / 3.1)
GROQ_API_KEY=your_groq_api_key_here

# 2. Google Gemini (First Fallback - Advanced Pedagogical & Structured Output)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Cloudflare Workers AI (Second Fallback - Serverless Edge Inference)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# 4. OpenAI (Optional Additional Provider)
OPENAI_API_KEY=your_openai_api_key_here

# Global Request timeout in milliseconds (default: 25000)
REQUEST_TIMEOUT_MS=25000

# ------------------------------------------------------------------------------
# MULTI-PROVIDER CLOUD TTS ENGINE CONFIGURATION (SERVER-SIDE ONLY)
# Routing Order:
# 1. ElevenLabs (Primary - Original default reader)
# 2. Deepgram Aura-2 / Flux (First Cloud Fallback - Ultra low latency)
# 3. Cartesia Sonic-3.6 (Second Cloud Fallback - High naturalness)
# 4. Browser SpeechSynthesis (Final Client Fallback)
# ------------------------------------------------------------------------------

# 1. ElevenLabs (Primary Provider)
ELEVENLABS_API_KEY=
ELEVENLABS_US_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_UK_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2

# 2. Deepgram (First Cloud Fallback)
DEEPGRAM_API_KEY=
DEEPGRAM_US_VOICE=aura-2-asteria-en
DEEPGRAM_UK_VOICE=aura-2-pandora-en

# 3. Cartesia Sonic (Second Cloud Fallback)
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_US_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
CARTESIA_UK_VOICE_ID=62ae83ad-4f6a-430b-af41-a9bede9286ca
# Set to 'true' only if you hold a paid commercial license for Cartesia in production
CARTESIA_COMMERCIAL_LICENSE=false

# ------------------------------------------------------------------------------
# EMAIL PROVIDER / SMTP CONFIGURATION (FOR VERIFICATION & RECOVERY)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@henglish.academy
SMTP_FROM_NAME=Henglish Academy

# ------------------------------------------------------------------------------
# YOUTUBE DATA API (Optional - Official Embeds work without API Key)
# ------------------------------------------------------------------------------
VITE_YOUTUBE_API_KEY=your_youtube_api_key_optional
